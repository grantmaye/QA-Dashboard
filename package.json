{
  "name": "qa-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Website quality checks, scan history, and issue triage.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "worker": "node --import tsx scripts/worker.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@electric-sql/pglite": "^0.5.8",
    "cheerio": "^1.2.0",
    "dataloader": "^2.2.3",
    "graphql": "^16.14.2",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.43.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "robots-parser": "^3.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
