# Explicit trusted-local demo. Missing/invalid identity configuration fails closed.
QA_IDENTITY_MODE=demo
QA_DEPLOYMENT_MODE=local
# Hosted mode requires authenticated identity and HTTPS APP_ORIGIN.
# The identity provider adapter is intentionally not implemented; authenticated mode returns 401.

# Default: one local Node process with embedded PostgreSQL. No setup required.
PGLITE_DATA_DIR=./.data/qa
# Optional external PostgreSQL, also required to run a separate worker process:
# DATABASE_URL=postgres://qa:qa@localhost:5432/qa
# Live scans are opt-in. Use only on public websites you have permission to check.
ENABLE_LIVE_SCANS=false

# Set the exact public origin behind a reverse proxy, for example https://qa.example.com:
# APP_ORIGIN=https://qa.example.com
